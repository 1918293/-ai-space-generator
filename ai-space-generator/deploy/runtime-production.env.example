# Metadata and non-secret values only. Secret values are injected from Secret Manager.
HAO_RUNTIME_ENV=production
HAO_RUNTIME_ROLE=api
HAO_RUNTIME_REGION=asia-east1
HAO_RELEASE_ID=<immutable-release-id>
HAO_DEPLOYMENT_ID=<cloud-run-revision-or-release-group>
HAO_DATABASE_SCHEMA_VERSION=3
HAO_DATABASE_RPO_SECONDS=300
HAO_DATABASE_RTO_SECONDS=3600
HAO_WORKER_INSTANCE_COUNT=1
HAO_GRACEFUL_SHUTDOWN_SECONDS=8
HAO_TEMPORAL_WORKER_VERSION=<immutable-worker-build-id>

# Required only to seed a brand-new empty operational_state. Existing durable state wins.
HAO_INITIAL_MODE=EXP
HAO_INITIAL_TASK=<deployment-seeded-task>

HAO_PUBLIC_MCP_URL=https://<runtime-host>/mcp
HAO_MCP_ALLOWED_HOSTS=<runtime-host>
HAO_MCP_ALLOWED_ORIGINS=
HAO_MCP_REQUEST_STATE_AUDIENCE=hao-system-control
# Passwordless/workload-bound example. If a password is embedded in HAO_DATABASE_URL,
# inject the entire URL from Secret Manager and add HAO_DATABASE_URL to the numeric
# HAO_SECRET_BINDINGS_JSON map below.
HAO_DATABASE_URL=postgresql://<database-user>@<cloud-sql>/runtime
HAO_TEMPORAL_ENDPOINT=<namespace-endpoint>
HAO_TEMPORAL_NAMESPACE=<namespace>
HAO_TEMPORAL_TASK_QUEUE=hao-runtime-v2
HAO_OAUTH_ISSUER_URL=https://<issuer>/
HAO_OAUTH_RESOURCE_URL=https://<runtime-host>/mcp
HAO_OAUTH_AUDIENCE=https://<runtime-host>/mcp
HAO_OAUTH_JWKS_URL=https://<issuer>/.well-known/jwks.json
HAO_EXPECTED_SUBJECT=<hao-subject>
HAO_ATTESTATION_KEY_ID=<completion-signing-key-id>
HAO_OTEL_ENDPOINT=http://127.0.0.1:4318

# Values of these variables are injected from Secret Manager at runtime.
HAO_TEMPORAL_API_KEY=<secret-manager-injected>
HAO_ATTESTATION_SECRET=<secret-manager-injected>
HAO_MCP_REQUEST_STATE_KEYS=<secret-manager-injected>

# Optional verification-only prior completion keys during a bounded rotation window.
# Keep {} when no prior key is accepted. When non-empty, inject the entire JSON value
# from Secret Manager and add HAO_ATTESTATION_PREVIOUS_KEYS_JSON to the numeric binding map.
HAO_ATTESTATION_PREVIOUS_KEYS_JSON={}

# Metadata only: every secret binding must name an immutable numeric Secret Manager version.
# Add HAO_DATABASE_URL here only when that URL embeds a password. Add
# HAO_ATTESTATION_PREVIOUS_KEYS_JSON only when the JSON map is non-empty.
HAO_SECRET_BINDINGS_JSON={"HAO_TEMPORAL_API_KEY":"projects/<project>/secrets/temporal-api-key/versions/<n>","HAO_ATTESTATION_SECRET":"projects/<project>/secrets/completion-signing/versions/<n>","HAO_MCP_REQUEST_STATE_KEYS":"projects/<project>/secrets/mcp-request-state-keys/versions/<n>"}

# Deployment-owned contracts; never model-authored. Parent children may additionally
# declare "depends_on_slots" as a list of sibling slot IDs; missing/cyclic references
# fail closed during startup plan validation.
HAO_SHEETS_TARGETS_JSON=<deployment-owned-json>
HAO_TASK_POLICIES_JSON=<deployment-owned-json>
HAO_PARENT_TASK_PLANS_JSON=<deployment-owned-json>
