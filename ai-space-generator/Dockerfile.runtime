FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY requirements-control.txt ./requirements-control.txt
RUN pip install --no-cache-dir -r requirements-control.txt

COPY src ./src

RUN useradd --create-home --uid 10001 hao-runtime \
    && chown -R hao-runtime:hao-runtime /app
USER hao-runtime

EXPOSE 8080

CMD ["python", "-m", "src.runtime_deployment"]
